{
  "name": "@jupytergis/jupytergis-root",
  "version": "0.18.1",
  "private": true,
  "homepage": "https://github.com/geojupyter/jupytergis",
  "repository": {
    "type": "git",
    "url": "https://github.com/geojupyter/jupytergis.git"
  },
  "license": "BSD-3-Clause",
  "description": "A JupyterLab extension for GIS.",
  "keywords": [
    "jupyter",
    "jupyterlab",
    "jupyterlab-extension"
  ],
  "bugs": {
    "url": "https://github.com/geojupyter/jupytergis/issues"
  },
  "author": {
    "name": "Jupytergis contributors"
  },
  "files": [
    "lib/**/*.{d.ts,eot,gif,html,jpg,js,js.map,json,png,svg,woff2,ttf}",
    "style/**/*.{css,js,eot,gif,html,jpg,json,png,svg,woff2,ttf}"
  ],
  "scripts": {
    "build": "lerna run build",
    "build:prod": "lerna run build:prod --skip-nx-cache",
    "build:test": "lerna run build:test",
    "build:dev": "lerna run build:dev",
    "bump:js:version": "lerna version --no-push --force-publish --no-git-tag-version --yes",
    "clean": "lerna run clean",
    "clean:all": "lerna run clean:all",
    "oxlint": "oxlint --fix",
    "oxlint:check": "oxlint",
    "oxfmt": "oxfmt \"**/*{.ts,.tsx,.js,.jsx,.css,.json,.md,.yml}\"",
    "oxfmt:check": "oxfmt --check \"**/*{.ts,.tsx,.js,.jsx,.css,.json,.md,.yml}\"",
    "lint:check": "pnpm run oxfmt:check && pnpm run oxlint:check",
    "lint": "pnpm run oxfmt && pnpm run oxlint",
    "test": "lerna run test",
    "dev": "python scripts/dev-install.py",
    "build:packages": "python scripts/build_packages.py",
    "watch:lib": "lerna run --stream watch",
    "watch": "lerna watch -- lerna run build --scope=\\$LERNA_PACKAGE_NAME --include-dependents",
    "build:lab": "lerna run",
    "bench:tsc": "node scripts/bench-tsc.mjs",
    "bench:build": "node scripts/bench-build.mjs"
  },
  "packageManager": "pnpm@11.17.0",
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@types/jest": "^30.0.0",
    "@types/webpack-env": "^1.18.5",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "copy-webpack-plugin": "^10.0.0",
    "eslint": "^8.36.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-import": "^2.31.0",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.4.1",
    "lerna": "^9.0.7",
    "npm-run-all": "^4.1.5",
    "oxfmt": "0.76.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2006",
    "py2vega-ts": "^0.1.2",
    "react-draggable": "4.5.0",
    "rimraf": "^3.0.2",
    "ts-jest": "^29.4.9",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vega2ol": "^1.2.0",
    "webpack": "^5.76.3",
    "zarrita": "^0.7.3"
  },
  "dependencies": {
    "prettier": "^3.9.10"
  }
}
