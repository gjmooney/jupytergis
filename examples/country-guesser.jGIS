    "044d590a-abf7-4abd-85fb-0912dcddb220": {
      "name": "Intro",
      "parameters": {
        "content": {
          "contentMode": "markdown",
          "markdown": "# Why geography still matters\n\nKnowing where places are is not trivia for its own sake. Borders, climate, trade routes, and neighbours shape history and the news you see every week.\n\nThis short quiz is a quick PoC: spot a country on the map, type its name, then read a little about it."
        },
        "enableIdentify": false,
        "extent": [
          -20037508.34,
          -10000000.0,
          20037508.34,
          15000000.0
        ],
