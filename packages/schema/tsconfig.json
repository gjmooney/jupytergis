{
  "extends": "../../tsconfigbase.json",
  "compilerOptions": {
    "outDir": "lib",
    "rootDir": "src",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "src/**/*",
    "src/processing/_generated/*.json",
    "src/schema/**/*.json",
    "src/_interface/*.json"
  ],
  "exclude": ["**/*.spec.ts"]
}
